# Cluster settings for the SLURM scripts. Copy this file to benchmark/slurm/cluster.env (ignored
# by git), fill it in, and submit every script through benchmark/slurm/submit.sh.

# SLURM account and quality of service (leave QOS empty if your cluster has none)
SLURM_ACCOUNT=my-project
SLURM_QOS=

# Where SLURM writes job logs (created by submit.sh)
LOG_DIR="${PWD}/slurm_logs"

# Shell commands that make conda (or mamba) available on a compute node,
# for example: 'module load Miniforge3; eval "$(conda shell.bash hook)"'
CONDA_SETUP='eval "$(conda shell.bash hook)"'

# Where setup_env.sh creates the benchmark environment
ENV_PREFIX="${HOME}/conda_envs/gridhunt"
